      "source": [
        "%%writefile agent/policy.py\n",
        "\"\"\"Rule-based budget policy: explore/exploit heuristic over recent performance.\"\"\"\n",
        "\n",
        "from dataclasses import dataclass\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "from agent.guardrails import GuardrailConfig\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Decision:\n",
        "    proposal: dict[str, float]  # proposed $ per channel (before guardrails)\n",
        "    reasons: dict[str, str]     # why, per channel\n",
        "    summary: str                # one-line summary of the day's decision\n",
        "    source: str = \"heuristic\"   # which policy actually produced it\n",
        "\n",
        "\n",
        "def describe(channel: str, m: pd.Series, objective: str) -> str:\n",
        "    \"\"\"Compact, factual description of a channel's recent metrics for reason strings.\"\"\"\n",
        "    stability = \"n/a\" if pd.isna(m[\"cpa_cv\"]) else f\"+/-{m['cpa_cv']:.0%}\"\n",
        "    if objective == \"clicks\":\n",
        "        return f\"{m['score']:.2f} clicks/$, CTR {m['ctr']:.2%}, CPC ${m['cpc']:.2f}\"\n",
        "    return f\"CVR {m['cvr']:.1%}, CPA ${m['cpa']:.2f} (day-to-day {stability}), CTR {m['ctr']:.2%}\"\n",
        "\n",
        "\n",
        "class HeuristicPolicy:\n",
        "    \"\"\"Start with an equal split, then each day move 10-20% of the leader's budget\n",
        "    toward the channel with the best outcomes per dollar, funded from the weakest\n",
        "    channel first. Guardrails (floors, caps, +/-20%) are applied afterwards.\"\"\"\n",
        "\n",
        "    def __init__(self, guardrails: GuardrailConfig, objective: str = \"conversions\",\n",
        "                 warmup_days: int = 3, min_edge: float = 0.05, volatile_cv: float = 0.5):\n",
        "        self.guardrails = guardrails\n",
        "        self.objective = objective\n",
        "        self.warmup_days = warmup_days    # equal split while we collect a few days of data\n",
        "        self.min_edge = min_edge          # leader must beat runner-up by >= 5% to act\n",
        "        self.volatile_cv = volatile_cv    # leader's CPA noisier than this -> take the smallest step\n",
        "\n",
        "    def decide(self, metrics: pd.DataFrame, previous: dict[str, float],\n",
        "               daily_budget: float, day_index: int) -> Decision:\n",
        "        channels = list(previous)\n",
        "\n",
        "        # 1) Warm-up: equal split until every channel has a few days of data.\n",
        "        if day_index < self.warmup_days or metrics[\"days_observed\"].min() < 2:\n",
        "            equal = {c: daily_budget / len(channels) for c in channels}\n",
        "            reasons = {c: f\"warm-up day {day_index + 1}/{self.warmup_days}: equal split while collecting data\"\n",
        "                       for c in channels}\n",
        "            return Decision(equal, reasons, \"Warm-up: equal split (explore)\")\n",
        "\n",
        "        # 2) Rank channels by smoothed outcomes per dollar.\n",
        "        ranked = metrics[\"score\"].sort_values(ascending=False)\n",
        "        order = list(ranked.index)\n",
        "        unit = \"clicks per $\" if self.objective == \"clicks\" else \"conversions per $\"\n",
        "        g = self.guardrails\n",
        "        floor, cap = g.min_share * daily_budget, g.max_share * daily_budget\n",
        "\n",
        "        # 3) The recipient is the best channel that still has room to grow\n",
        "        #    (usually the leader; the runner-up if the leader is already at the cap).\n",
        "        headroom = {c: min(cap, previous[c] * (1 + g.max_daily_change)) - previous[c] for c in channels}\n",
        "        recipient = next((c for c in order[:-1] if headroom[c] > 0.01 * daily_budget), None)\n",
        "        capped = [c for c in order[: order.index(recipient)]] if recipient else order[:-1]\n",
        "        donors = order[order.index(recipient) + 1:][::-1] if recipient else []  # weakest first\n",
        "        best_donor = donors[-1] if donors else None\n",
        "        edge = (ranked[recipient] / ranked[best_donor] - 1) if recipient and ranked[best_donor] > 0 else 0.0\n",
        "\n",
        "        # 4) No clear winner (or nowhere to move money) -> hold, to avoid chasing noise.\n",
        "        if recipient is None or edge < self.min_edge:\n",
        "            why = (f\"no clear winner ({recipient} only {edge:+.0%} {unit} vs {best_donor})\" if recipient\n",
        "                   else \"every better channel is already at its cap\")\n",
        "            reasons = {c: f\"{why}; {describe(c, metrics.loc[c], self.objective)}\" for c in channels}\n",
        "            return Decision(dict(previous), reasons, f\"Hold: {why}\")\n",
        "\n",
        "        # 5) Step size grows with the size of the edge (10% / 15% / 20%) ...\n",
        "        step = 0.10 if edge < 0.15 else 0.15 if edge < 0.35 else 0.20\n",
        "        volatile = not pd.isna(metrics.loc[recipient, \"cpa_cv\"]) and metrics.loc[recipient, \"cpa_cv\"] > self.volatile_cv\n",
        "        if volatile:  # ... but stays small when the recipient's CPA is jumpy.\n",
        "            step = 0.10\n",
        "\n",
        "        # 6) Move money to the recipient, taking it from the weakest channel first\n",
        "        #    and never pushing a donor below its floor / -20% limit.\n",
        "        proposal = dict(previous)\n",
        "        to_move = min(step * previous[recipient], headroom[recipient])\n",
        "        taken = {c: 0.0 for c in channels}\n",
        "        for donor in donors:\n",
        "            donor_min = max(floor, previous[donor] * (1 - g.max_daily_change))\n",
        "            take = max(0.0, min(previous[donor] - donor_min, to_move - sum(taken.values())))\n",
        "            taken[donor] = take\n",
        "            proposal[donor] -= take\n",
        "        proposal[recipient] += sum(taken.values())\n",
        "\n",
        "        # Every weaker channel is already at its floor -> nothing can move today.\n",
        "        if sum(taken.values()) < 0.01 * daily_budget:\n",
        "            why = f\"{recipient} could grow, but {', '.join(donors)} already at the {g.min_share:.0%} floor\"\n",
        "            reasons = {c: f\"hold: {why}; {describe(c, metrics.loc[c], self.objective)}\" for c in channels}\n",
        "            return Decision(dict(previous), reasons, f\"Hold: {why}\")\n",
        "\n",
        "        # 7) Reason strings (the runner adds the $ change and any guardrail that bit).\n",
        "        stab = \"volatile CPA, so smallest step\" if volatile else \"stable CPA\"\n",
        "        reasons = {}\n",
        "        for c in channels:\n",
        "            facts = describe(c, metrics.loc[c], self.objective)\n",
        "            if c == recipient:\n",
        "                rank = \"best\" if c == order[0] else f\"#{order.index(c) + 1}\"\n",
        "                reasons[c] = f\"{rank} {unit} with room to grow ({facts}); {edge:+.0%} vs {best_donor}; {stab}\"\n",
        "            elif c in capped:\n",
        "                reasons[c] = f\"best {unit} but already at the {g.max_share:.0%} cap ({facts})\"\n",
        "            elif taken[c] > 0:\n",
        "                rank = \"lowest\" if c == order[-1] else \"weaker\"\n",
        "                reasons[c] = f\"{rank} {unit} ({facts}); budget shifted to {recipient}\"\n",
        "            elif c in donors and previous[c] <= floor + 0.01:\n",
        "                reasons[c] = f\"weakest but kept at the {g.min_share:.0%} floor to keep learning ({facts})\"\n",
        "            else:\n",
        "                reasons[c] = f\"kept: rank {order.index(c) + 1} of {len(channels)} ({facts})\"\n",
        "        summary = f\"Shift ~{step:.0%} toward {recipient} (edge {edge:+.0%} vs {best_donor})\"\n",
        "        return Decision(proposal, reasons, summary)"
      ]
    },
