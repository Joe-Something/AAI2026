      "source": [
        "%%writefile agent/llm_policy.py\n",
        "\"\"\"Optional LLM policy: Gemini reads metrics through a tool and proposes a budget plan.\n",
        "\n",
        "The LLM never has the last word - its plan still goes through `apply_guardrails`.\n",
        "Any failure (no API key, API error, blocked response, no plan, token budget spent)\n",
        "falls back to the rule-based policy for that day and is logged.\n",
        "\"\"\"\n",
        "\n",
        "import json\n",
        "import logging\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "from agent.guardrails import GuardrailConfig\n",
        "from agent.policy import Decision, HeuristicPolicy\n",
        "\n",
        "log = logging.getLogger(__name__)\n",
        "\n",
        "SYSTEM_PROMPT = (Path(__file__).resolve().parent.parent / \"prompts\" / \"system_prompt.md\").read_text()\n",
        "MAX_TURNS_PER_DAY = 4  # get metrics -> submit plan, plus slack for one retry\n",
        "\n",
        "# Models to try, in order. \"gemini-flash-latest\" always points at Google's current\n",
        "# Flash model; the pinned name is a backup if the alias is unavailable to the key.\n",
        "# Override with GEMINI_MODEL, e.g. GEMINI_MODEL=gemini-2.5-pro.\n",
        "MODELS = [os.environ[\"GEMINI_MODEL\"]] if os.environ.get(\"GEMINI_MODEL\") else [\"gemini-flash-latest\", \"gemini-2.5-flash\"]\n",
        "\n",
        "# Every common name a Gemini / Google AI Studio key is stored under, checked in order.\n",
        "# GEMINI_API_KEY and GOOGLE_API_KEY are the two the official google-genai SDK reads;\n",
        "# the rest are conventions used by other libraries and tutorials.\n",
        "GEMINI_KEY_NAMES = [\n",
        "    \"GEMINI_API_KEY\",                 # Google AI Studio default\n",
        "    \"GOOGLE_API_KEY\",                 # google-genai SDK / LangChain default\n",
        "    \"GOOGLE_GENAI_API_KEY\",\n",
        "    \"GOOGLE_GENERATIVE_AI_API_KEY\",   # Vercel AI SDK convention\n",
        "    \"GOOGLE_AI_API_KEY\",\n",
        "    \"GOOGLE_AI_STUDIO_API_KEY\",\n",
        "    \"GENAI_API_KEY\",\n",
        "    \"GEMINI_KEY\",\n",
        "]\n",
        "\n",
        "\n",
        "def find_gemini_api_key() -> tuple[str | None, str | None]:\n",
        "    \"\"\"Return (key, where it was found). Checks environment variables first, then\n",
        "    Colab Secrets (the key icon in Colab's sidebar). Never logs the key itself.\"\"\"\n",
        "    for name in GEMINI_KEY_NAMES:\n",
        "        if os.environ.get(name):\n",
        "            return os.environ[name], f\"environment variable {name}\"\n",
        "    try:\n",
        "        from google.colab import userdata  # only exists inside Colab\n",
        "    except ImportError:\n",
        "        return None, None\n",
        "    for name in GEMINI_KEY_NAMES:\n",
        "        try:\n",
        "            value = userdata.get(name)\n",
        "        except Exception:  # secret missing, or notebook access not granted\n",
        "            continue\n",
        "        if value:\n",
        "            return value, f\"Colab secret {name}\"\n",
        "    return None, None\n",
        "\n",
        "\n",
        "def build_tools(channels: list[str]):\n",
        "    \"\"\"Tool (function) declarations. The plan schema is built from the CSV's channel names.\"\"\"\n",
        "    from google.genai import types\n",
        "\n",
        "    per_channel = lambda kind: {  # noqa: E731 - small schema helper\n",
        "        \"type\": \"object\",\n",
        "        \"properties\": {c: {\"type\": kind} for c in channels},\n",
        "        \"required\": channels,\n",
        "    }\n",
        "    return [types.Tool(function_declarations=[\n",
        "        types.FunctionDeclaration(\n",
        "            name=\"get_channel_metrics\",\n",
        "            description=\"Return recent performance per channel (recency-weighted spend, CTR, CVR, CPC, \"\n",
        "                        \"CPA, CPA stability, smoothed conversions-per-dollar score), yesterday's \"\n",
        "                        \"allocation in dollars, today's daily budget and the guardrail limits.\",\n",
        "            parameters_json_schema={\"type\": \"object\", \"properties\": {}},\n",
        "        ),\n",
        "        types.FunctionDeclaration(\n",
        "            name=\"submit_budget_plan\",\n",
        "            description=\"Submit today's budget plan. Call exactly once, after reading the metrics. \"\n",
        "                        \"Allocations are dollars per channel and must sum to the daily budget.\",\n",
        "            parameters_json_schema={\n",
        "                \"type\": \"object\",\n",
        "                \"properties\": {\n",
        "                    \"allocations\": per_channel(\"number\"),\n",
        "                    \"reasons\": per_channel(\"string\"),\n",
        "                    \"summary\": {\"type\": \"string\"},\n",
        "                },\n",
        "                \"required\": [\"allocations\", \"reasons\", \"summary\"],\n",
        "            },\n",
        "        ),\n",
        "    ])]\n",
        "\n",
        "\n",
        "def clean_reason(text: str, limit: int = 240) -> str:\n",
        "    \"\"\"Brand-tone/audit guardrail: one line, bounded length.\"\"\"\n",
        "    text = \" \".join(str(text).split())\n",
        "    return text if len(text) <= limit else text[: limit - 1] + \"…\"\n",
        "\n",
        "\n",
        "class GeminiPolicy:\n",
        "    def __init__(self, guardrails: GuardrailConfig, objective: str = \"conversions\",\n",
        "                 max_total_tokens: int = 300_000, client=None):\n",
        "        self.guardrails = guardrails\n",
        "        self.objective = objective\n",
        "        self.fallback = HeuristicPolicy(guardrails, objective)\n",
        "        self.max_total_tokens = max_total_tokens  # cost cap for the whole run\n",
        "        self.tokens_used = 0\n",
        "        self.models = list(MODELS)\n",
        "        self.disabled_reason = None               # set when the LLM is switched off for the run\n",
        "        self.client = client\n",
        "        if self.client is None:\n",
        "            self._connect()\n",
        "\n",
        "    def _connect(self) -> None:\n",
        "        api_key, source = find_gemini_api_key()\n",
        "        if not api_key:\n",
        "            self.disabled_reason = f\"no Gemini API key found (tried {', '.join(GEMINI_KEY_NAMES)})\"\n",
        "            return\n",
        "        try:\n",
        "            from google import genai\n",
        "            from google.genai import types\n",
        "        except ImportError:\n",
        "            self.disabled_reason = \"google-genai not installed (pip install google-genai)\"\n",
        "            return\n",
        "        log.info(\"Using Gemini API key from %s\", source)\n",
        "        self.client = genai.Client(api_key=api_key, http_options=types.HttpOptions(\n",
        "            timeout=120_000,  # milliseconds\n",
        "            # Back off and retry on 408 / 429 (free-tier rate limits) / 5xx.\n",
        "            retry_options=types.HttpRetryOptions(attempts=5, initial_delay=2.0, max_delay=60.0),\n",
        "        ))\n",
        "\n",
        "    def _fallback(self, why: str, *args) -> Decision:\n",
        "        if why != getattr(self, \"_last_fallback\", None):  # warn once per distinct reason\n",
        "            log.warning(\"LLM policy fallback to heuristic: %s\", why)\n",
        "            self._last_fallback = why\n",
        "        decision = self.fallback.decide(*args)\n",
        "        decision.source = f\"heuristic (LLM fallback: {why})\"\n",
        "        return decision\n",
        "\n",
        "    def decide(self, metrics: pd.DataFrame, previous: dict[str, float],\n",
        "               daily_budget: float, day_index: int) -> Decision:\n",
        "        from google.genai import errors, types\n",
        "\n",
        "        args = (metrics, previous, daily_budget, day_index)\n",
        "        if self.disabled_reason:\n",
        "            return self._fallback(self.disabled_reason, *args)\n",
        "        if self.tokens_used >= self.max_total_tokens:\n",
        "            return self._fallback(f\"token budget of {self.max_total_tokens:,} used up\", *args)\n",
        "\n",
        "        channels = list(previous)\n",
        "        g = self.guardrails\n",
        "        metrics_payload = json.loads(json.dumps({\n",
        "            \"objective\": self.objective,\n",
        "            \"daily_budget\": daily_budget,\n",
        "            \"yesterday_allocation\": {c: round(v, 2) for c, v in previous.items()},\n",
        "            \"limits\": {\"min_share\": g.min_share, \"max_share\": g.max_share,\n",
        "                       \"max_daily_change\": g.max_daily_change, \"max_zero_days\": g.max_zero_days},\n",
        "            \"metrics\": metrics.round(4).reset_index().to_dict(\"records\"),\n",
        "        }, default=str))  # round-trip through JSON so every value is a plain type\n",
        "\n",
        "        contents = [types.Content(role=\"user\", parts=[types.Part(text=(\n",
        "            f\"Day {day_index + 1}. Daily budget: ${daily_budget:,.2f}. \"\n",
        "            f\"Channels: {', '.join(channels)}. Read the metrics, then submit today's plan.\"))])]\n",
        "        config = types.GenerateContentConfig(\n",
        "            system_instruction=SYSTEM_PROMPT,\n",
        "            tools=build_tools(channels),\n",
        "            # ANY = the model must answer with a function call every turn.\n",
        "            tool_config=types.ToolConfig(function_calling_config=types.FunctionCallingConfig(mode=\"ANY\")),\n",
        "            automatic_function_calling=types.AutomaticFunctionCallingConfig(disable=True),\n",
        "        )\n",
        "        metrics_read = False\n",
        "\n",
        "        for _ in range(MAX_TURNS_PER_DAY):\n",
        "            try:\n",
        "                response = self.client.models.generate_content(model=self.models[0], contents=contents, config=config)\n",
        "            except errors.ClientError as exc:\n",
        "                if exc.code == 404 and len(self.models) > 1:  # model name not available -> try the next one\n",
        "                    log.warning(\"Model %s not found, trying %s\", self.models[0], self.models[1])\n",
        "                    self.models.pop(0)\n",
        "                    continue\n",
        "                if exc.code == 429:\n",
        "                    return self._fallback(\"rate limited after retries\", *args)\n",
        "                # 400 (e.g. invalid API key), 401, 403, 404: won't fix itself -> stop using the LLM.\n",
        "                self.disabled_reason = f\"Gemini API error {exc.code}: {exc.message}\"\n",
        "                return self._fallback(self.disabled_reason, *args)\n",
        "            except errors.ServerError as exc:\n",
        "                return self._fallback(f\"Gemini server error {exc.code}\", *args)\n",
        "            except Exception as exc:  # network failures and anything unexpected\n",
        "                return self._fallback(f\"{type(exc).__name__}: {exc}\", *args)\n",
        "\n",
        "            usage = response.usage_metadata\n",
        "            self.tokens_used += (usage.total_token_count or 0) if usage else 0\n",
        "            log.info(\"LLM call: model=%s response_id=%s tokens=%s\", self.models[0], response.response_id,\n",
