      "source": [
        "%%writefile agent/metrics.py\n",
        "\"\"\"Performance metrics the agent reasons over (CTR, CVR, CPC, CPA, value per dollar).\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Which outcome the agent maximizes, and the column that counts it.\n",
        "OBJECTIVE_COLUMN = {\"conversions\": \"conversions\", \"clicks\": \"clicks\"}\n",
        "\n",
        "\n",
        "def safe_div(numerator: float, denominator: float) -> float:\n",
        "    return float(numerator) / float(denominator) if denominator else 0.0\n",
        "\n",
        "\n",
        "def channel_metrics(\n",
        "    history: pd.DataFrame,\n",
        "    channels: list[str],\n",
        "    objective: str = \"conversions\",\n",
        "    window_days: int = 7,\n",
        "    decay: float = 0.85,\n",
        "    prior_spend: float = 300.0,\n",
        ") -> pd.DataFrame:\n",
        "    \"\"\"Summarize each channel's recent performance.\n",
        "\n",
        "    history      rows of date/channel/spend/impressions/clicks/conversions the\n",
        "                 agent has observed so far (never includes the day being decided).\n",
        "    window_days  only the most recent N days are used, so old behaviour ages out.\n",
        "    decay        recency weight per day of age (yesterday = 1, the day before = 0.85, ...).\n",
        "    prior_spend  Bayesian shrinkage: every channel starts with this many pseudo-dollars\n",
        "                 at the pooled average rate, so a lucky day with little data does not\n",
        "                 trigger a big shift. This is the \"learning\" part - estimates sharpen\n",
        "                 as real data accumulates.\n",
        "\n",
        "    Returns one row per channel; `score` is outcomes per dollar (higher = better),\n",
        "    which is exactly 1 / CPA when the objective is conversions.\n",
        "    \"\"\"\n",
        "    outcome_col = OBJECTIVE_COLUMN[objective]\n",
        "    rows = []\n",
        "    if history.empty:\n",
        "        recent = history\n",
        "    else:\n",
        "        last_day = history[\"date\"].max()\n",
        "        recent = history[history[\"date\"] > last_day - pd.Timedelta(days=window_days)].copy()\n",
        "        age_days = (last_day - recent[\"date\"]).dt.days\n",
        "        recent[\"weight\"] = decay ** age_days\n",
        "\n",
        "    # Pooled outcome rate across all channels = the prior every channel shrinks toward.\n",
        "    pooled_rate = safe_div(recent[outcome_col].sum(), recent[\"spend\"].sum()) if not recent.empty else 0.0\n",
        "\n",
        "    for channel in channels:\n",
        "        ch = recent[recent[\"channel\"] == channel] if not recent.empty else recent\n",
        "        w = ch[\"weight\"] if not ch.empty else pd.Series(dtype=float)\n",
        "        spend = float((ch[\"spend\"] * w).sum()) if not ch.empty else 0.0\n",
        "        impressions = float((ch[\"impressions\"] * w).sum()) if not ch.empty else 0.0\n",
        "        clicks = float((ch[\"clicks\"] * w).sum()) if not ch.empty else 0.0\n",
        "        conversions = float((ch[\"conversions\"] * w).sum()) if not ch.empty else 0.0\n",
        "        outcomes = conversions if outcome_col == \"conversions\" else clicks\n",
        "\n",
        "        # Stability: how much the daily CPA bounces around (coefficient of variation).\n",
        "        daily_cpa = (ch[\"spend\"] / ch[\"conversions\"].replace(0, np.nan)).dropna() if not ch.empty else []\n",
        "        cpa_cv = float(np.std(daily_cpa) / np.mean(daily_cpa)) if len(daily_cpa) >= 2 else float(\"nan\")\n",
        "\n",
        "        rows.append({\n",
        "            \"channel\": channel,\n",
        "            \"days_observed\": int(len(ch)),\n",
        "            \"spend\": spend,\n",
        "            \"ctr\": safe_div(clicks, impressions),\n",
        "            \"cvr\": safe_div(conversions, clicks),\n",
        "            \"cpc\": safe_div(spend, clicks),\n",
        "            \"cpa\": safe_div(spend, conversions),\n",
        "            \"cpa_cv\": cpa_cv,\n",
        "            # Smoothed outcomes per dollar (the ranking score).\n",
        "            \"score\": safe_div(outcomes + pooled_rate * prior_spend, spend + prior_spend),\n",
        "        })\n",
        "    return pd.DataFrame(rows).set_index(\"channel\")"
      ]
    },
