          ]
        }
      ],
      "source": [
        "%%writefile agent/guardrails.py\n",
        "\"\"\"Hard budget guardrails. Every proposal - rule-based or LLM - passes through here.\"\"\"\n",
        "\n",
        "from dataclasses import dataclass\n",
        "\n",
        "\n",
        "@dataclass(frozen=True)\n",
        "class GuardrailConfig:\n",
        "    min_share: float = 0.10         # exploration floor: each channel keeps >= 10% of the daily budget\n",
        "    max_share: float = 0.70         # concentration cap: no channel gets more than 70%\n",
        "    max_daily_change: float = 0.20  # a channel's budget moves at most +/-20% vs yesterday\n",
        "    max_zero_days: int = 2          # a channel may never sit at $0 for more than 2 days in a row\n",
        "\n",
        "\n",
        "def apply_guardrails(\n",
        "    proposal: dict[str, float],\n",
        "    previous: dict[str, float],\n",
        "    daily_budget: float,\n",
        "    config: GuardrailConfig,\n",
        "    zero_streaks: dict[str, int],\n",
        ") -> tuple[dict[str, float], dict[str, list[str]]]:\n",
        "    \"\"\"Project a proposed allocation onto the set of allowed allocations.\n",
        "\n",
        "    Each channel gets a lower and upper bound from the floor/cap and the +/-20%\n",
        "    rule; then one common offset is added to every proposal (found by bisection)\n",
        "    so that the clipped amounts add up exactly to the daily budget (cost cap).\n",
        "    Returns the final allocation and, per channel, a list of guardrails that bit.\n",
        "    \"\"\"\n",
        "    channels = list(proposal)\n",
        "    floor, cap = config.min_share * daily_budget, config.max_share * daily_budget\n",
        "\n",
        "    lower, upper, notes = {}, {}, {c: [] for c in channels}\n",
        "    for c in channels:\n",
        "        prev = previous.get(c, daily_budget / len(channels))\n",
        "        lower[c] = max(floor, prev * (1 - config.max_daily_change))\n",
        "        upper[c] = min(cap, prev * (1 + config.max_daily_change))\n",
        "        # Never let a channel stay at $0 past the allowed streak.\n",
        "        if zero_streaks.get(c, 0) >= config.max_zero_days:\n",
        "            lower[c] = max(lower[c], floor)\n",
        "        if lower[c] > upper[c]:  # floor wins if the rules ever conflict\n",
        "            upper[c] = lower[c]\n",
        "\n",
        "    # Bisection on the common offset so sum(clip(proposal + offset)) == budget.\n",
        "    def total_at(offset: float) -> float:\n",
        "        return sum(min(max(proposal[c] + offset, lower[c]), upper[c]) for c in channels)\n",
        "\n",
        "    lo, hi = -daily_budget * 2, daily_budget * 2\n",
        "    for _ in range(100):\n",
        "        mid = (lo + hi) / 2\n",
        "        lo, hi = (mid, hi) if total_at(mid) < daily_budget else (lo, mid)\n",
        "    offset = (lo + hi) / 2\n",
        "    final = {c: round(min(max(proposal[c] + offset, lower[c]), upper[c]), 2) for c in channels}\n",
        "\n",
        "    # Fix rounding pennies on the largest channel so the total is exact.\n",
        "    drift = round(daily_budget - sum(final.values()), 2)\n",
        "    if drift:\n",
        "        final[max(final, key=final.get)] += drift\n",
        "\n",
        "    for c in channels:\n",
        "        prev = previous.get(c, daily_budget / len(channels))\n",
        "        if abs(final[c] - proposal[c]) > 0.01 * daily_budget:\n",
        "            if final[c] <= floor + 0.01:\n",
        "                notes[c].append(f\"held at {config.min_share:.0%} floor\")\n",
        "            elif final[c] >= cap - 0.01:\n",
        "                notes[c].append(f\"capped at {config.max_share:.0%} max share\")\n",
        "            elif abs(final[c] - prev * (1 + config.max_daily_change)) < 0.02 or abs(final[c] - prev * (1 - config.max_daily_change)) < 0.02:\n",
        "                notes[c].append(f\"limited by +/-{config.max_daily_change:.0%} daily change cap\")\n",
        "            else:\n",
        "                notes[c].append(\"rebalanced so the total equals the daily budget\")\n",
        "    return final, notes"
      ]
    },
