        "### `data/generate_mock_data.py`\n",
        "Creates the mock CSV: 30 days x 3 channels (Search, Social, Display)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "834bdfef",
      "metadata": {
        "id": "834bdfef",
        "outputId": "310e2349-f099-408f-d5b6-90d6833357da"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Overwriting data/generate_mock_data.py\n"
          ]
        }
      ],
      "source": [
        "%%writefile data/generate_mock_data.py\n",
        "\"\"\"Generate a reproducible mock ad-performance CSV (30 days x 3 channels).\n",
        "\n",
        "The numbers are synthetic but shaped like real paid-media data:\n",
        "  * Search  - expensive clicks, high purchase intent (high CVR), steady.\n",
        "  * Social  - cheap clicks, mediocre CVR at first; a creative refresh on day 12\n",
        "              lifts its CVR, so the best channel changes mid-month.\n",
        "  * Display - very cheap impressions, low CTR and low CVR (worst CPA).\n",
        "Weekends get a small Social bump and a small Search dip.\n",
        "\n",
        "The history was \"run\" with a roughly equal split ($1,000/channel/day), which is\n",
        "also what the equal-split baseline does.\n",
        "\n",
        "Usage:\n",
        "    python data/generate_mock_data.py                     # -> data/ad_performance.csv\n",
        "    python data/generate_mock_data.py --days 21 --seed 7 --out data/other.csv\n",
        "\"\"\"\n",
        "\n",
        "import argparse\n",
        "from datetime import date, timedelta\n",
        "from pathlib import Path\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Per-channel \"true\" behaviour: cost per 1,000 impressions, click-through rate,\n",
        "# conversion rate (conversions / clicks).\n",
        "CHANNEL_PROFILES = {\n",
        "    \"Search\":  {\"cpm\": 70.0, \"ctr\": 0.035, \"cvr\": 0.060},\n",
        "    \"Social\":  {\"cpm\": 11.0, \"ctr\": 0.012, \"cvr\": 0.028},\n",
        "    \"Display\": {\"cpm\": 2.0,  \"ctr\": 0.004, \"cvr\": 0.009},\n",
        "}\n",
        "SOCIAL_REFRESH_DAY = 12        # day index when Social's new creative goes live\n",
        "SOCIAL_REFRESH_CVR = 0.042     # Social CVR after the refresh\n",
        "DAILY_SPEND_PER_CHANNEL = 1000.0\n",
        "\n",
        "\n",
        "def generate(days: int = 30, seed: int = 42, start: date = date(2026, 9, 1)) -> pd.DataFrame:\n",
        "    rng = np.random.default_rng(seed)\n",
        "    rows = []\n",
        "    for day_index in range(days):\n",
        "        current_date = start + timedelta(days=day_index)\n",
        "        is_weekend = current_date.weekday() >= 5\n",
        "        for channel, profile in CHANNEL_PROFILES.items():\n",
        "            ctr, cvr = profile[\"ctr\"], profile[\"cvr\"]\n",
        "            if channel == \"Social\" and day_index >= SOCIAL_REFRESH_DAY:\n",
        "                cvr = SOCIAL_REFRESH_CVR\n",
        "            if is_weekend and channel == \"Social\":\n",
        "                ctr *= 1.10\n",
        "            if is_weekend and channel == \"Search\":\n",
        "                cvr *= 0.90\n",
        "            # Day-to-day market noise on the underlying rates (+/- ~10-15%).\n",
        "            ctr *= rng.lognormal(0, 0.10)\n",
        "            cvr *= rng.lognormal(0, 0.15)\n",
        "\n",
        "            spend = round(DAILY_SPEND_PER_CHANNEL * rng.uniform(0.95, 1.05), 2)\n",
        "            impressions = int(rng.poisson(spend / profile[\"cpm\"] * 1000))\n",
        "            clicks = int(rng.binomial(impressions, min(ctr, 1.0)))\n",
        "            conversions = int(rng.binomial(clicks, min(cvr, 1.0)))\n",
        "            rows.append({\n",
        "                \"date\": current_date.isoformat(),\n",
        "                \"channel\": channel,\n",
        "                \"spend\": spend,\n",
        "                \"impressions\": impressions,\n",
        "                \"clicks\": clicks,\n",
        "                \"conversions\": conversions,\n",
        "            })\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "\n",
        "def main() -> None:\n",
        "    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n",
        "    parser.add_argument(\"--days\", type=int, default=30, help=\"number of days (14-30 recommended)\")\n",
        "    parser.add_argument(\"--seed\", type=int, default=42, help=\"random seed for reproducibility\")\n",
        "    parser.add_argument(\"--out\", default=str(Path(__file__).with_name(\"ad_performance.csv\")))\n",
        "    args = parser.parse_args()\n",
        "\n",
        "    df = generate(days=args.days, seed=args.seed)\n",
        "    df.to_csv(args.out, index=False)\n",
        "    print(f\"Wrote {len(df)} rows ({args.days} days x {df['channel'].nunique()} channels) to {args.out}\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    },
