        "    ax2.set_ylabel(f\"Cumulative {key}\", color=INK, fontsize=9)\n",
        "    ax2.set_title(f\"Cumulative {key}: agent vs equal split\", loc=\"left\", color=INK, fontsize=11)\n",
        "    ax2.legend(loc=\"upper center\", bbox_to_anchor=(0.5, -0.08), fontsize=8, frameon=False, ncols=2)\n",
        "\n",
        "    fig.tight_layout()\n",
        "    fig.savefig(path, dpi=150, facecolor=\"white\")\n",
        "    plt.close(fig)"
