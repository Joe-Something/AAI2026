      "source": [
        "%%writefile agent/simulation.py\n",
        "\"\"\"Offline replay: run a policy day by day over the CSV and score it against baselines.\n",
        "\n",
        "How outcomes are simulated\n",
        "--------------------------\n",
        "The CSV says what each channel delivered on each day at the spend it actually got.\n",
        "When a policy gives a channel a different budget on that day, we scale that day's\n",
        "observed numbers:\n",
        "\n",
        "    impressions  ~ ratio                (you buy impressions roughly linearly)\n",
        "    clicks, conv ~ ratio ** elasticity  (more spend -> diminishing returns)\n",
        "\n",
        "where ratio = new spend / observed spend. elasticity = 1.0 is a pure linear\n",
        "replay (optimistic); 0.8 (default) assumes each extra dollar is a bit less\n",
        "productive. Decisions for day t only ever use data from days < t.\n",
        "\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from agent.guardrails import GuardrailConfig, apply_guardrails\n",
        "from agent.metrics import channel_metrics, safe_div\n",
        "\n",
        "METRIC_COLUMNS = [\"spend\", \"impressions\", \"clicks\", \"conversions\"]\n",
        "\n",
        "\n",
        "def simulate_day(day_rows: pd.DataFrame, allocation: dict[str, float], elasticity: float) -> pd.DataFrame:\n",
        "    \"\"\"Outcomes for one day if each channel had been given allocation[channel] dollars.\"\"\"\n",
        "    rows = []\n",
        "    for channel, spend in allocation.items():\n",
        "        actual = day_rows.loc[channel]\n",
        "        ratio = safe_div(spend, actual[\"spend\"])\n",
        "        rows.append({\n",
        "            \"date\": actual[\"date\"],\n",
        "            \"channel\": channel,\n",
        "            \"spend\": spend,\n",
        "            \"impressions\": actual[\"impressions\"] * ratio,\n",
        "            \"clicks\": actual[\"clicks\"] * ratio ** elasticity,\n",
        "            \"conversions\": actual[\"conversions\"] * ratio ** elasticity,\n",
        "        })\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "\n",
        "def run_policy(data: pd.DataFrame, policy, daily_budget: float, guardrails: GuardrailConfig,\n",
        "               elasticity: float = 0.8, objective: str = \"conversions\"):\n",
        "    \"\"\"The agent loop: observe -> compute metrics -> decide -> guardrails -> act -> log.\n",
        "\n",
        "    Returns (outcomes per day/channel, decision log rows, one summary record per day).\n",
        "    \"\"\"\n",
        "    channels = sorted(data[\"channel\"].unique())\n",
        "    dates = sorted(data[\"date\"].unique())\n",
        "    previous = {c: daily_budget / len(channels) for c in channels}  # start from an equal split\n",
        "    zero_streaks = {c: 0 for c in channels}\n",
        "    observed = pd.DataFrame(columns=[\"date\", \"channel\", *METRIC_COLUMNS])\n",
        "    decision_log, daily_log = [], []\n",
        "\n",
        "    for day_index, day in enumerate(dates):\n",
        "        # 1) Observe: metrics from everything the agent has seen so far (days < today).\n",
        "        metrics = channel_metrics(observed, channels, objective)\n",
        "        # 2) Decide (rule-based or LLM).\n",
        "        decision = policy.decide(metrics, previous, daily_budget, day_index)\n",
        "        # 3) Guardrails always have the final say.\n",
        "        final, notes = apply_guardrails(decision.proposal, previous, daily_budget, guardrails, zero_streaks)\n",
        "        # 4) Act: spend today's budget and record what came back.\n",
        "        day_rows = data[data[\"date\"] == day].set_index(\"channel\").assign(date=day)\n",
        "        outcome = simulate_day(day_rows, final, elasticity)\n",
        "        observed = outcome if observed.empty else pd.concat([observed, outcome], ignore_index=True)\n",
        "\n",
        "        # 5) Log every channel's decision with a human-readable reason.\n",
        "        for c in channels:\n",
        "            zero_streaks[c] = zero_streaks[c] + 1 if final[c] <= 0 else 0\n",
        "            change = safe_div(final[c] - previous[c], previous[c])\n",
        "            verb = \"up\" if change > 0.005 else \"down\" if change < -0.005 else \"held\"\n",
        "            moved = f\" {abs(change):.1%}\" if verb != \"held\" else \"\"\n",
        "            reason = f\"{c} {verb}{moved} (${previous[c]:,.0f} -> ${final[c]:,.0f}): {decision.reasons[c]}\"\n",
        "            if notes[c]:\n",
        "                reason += f\" [guardrail: {'; '.join(notes[c])}]\"\n",
        "            decision_log.append({\n",
        "                \"date\": pd.Timestamp(day).date().isoformat(),\n",
        "                \"day\": day_index + 1,\n",
        "                \"policy\": decision.source,\n",
        "                \"channel\": c,\n",
        "                \"previous_budget\": round(previous[c], 2),\n",
        "                \"proposed_budget\": round(decision.proposal[c], 2),\n",
        "                \"final_budget\": round(final[c], 2),\n",
        "                \"change_pct\": round(change * 100, 1),\n",
        "                \"share_pct\": round(final[c] / daily_budget * 100, 1),\n",
        "                \"score\": round(metrics.loc[c, \"score\"], 5),\n",
        "                \"ctr_pct\": round(metrics.loc[c, \"ctr\"] * 100, 2),\n",
        "                \"cvr_pct\": round(metrics.loc[c, \"cvr\"] * 100, 2),\n",
        "                \"cpa\": round(metrics.loc[c, \"cpa\"], 2),\n",
        "                \"guardrails\": \"; \".join(notes[c]),\n",
        "                \"reason\": reason,\n",
        "            })\n",
        "        daily_log.append({\n",
        "            \"date\": pd.Timestamp(day).date().isoformat(),\n",
        "            \"day\": day_index + 1,\n",
        "            \"policy\": decision.source,\n",
        "            \"summary\": decision.summary,\n",
        "            \"allocation\": final,\n",
        "            \"conversions\": round(outcome[\"conversions\"].sum(), 2),\n",
        "            \"clicks\": round(outcome[\"clicks\"].sum(), 2),\n",
        "            \"spend\": round(outcome[\"spend\"].sum(), 2),\n",
        "        })\n",
        "        previous = final\n",
        "\n",
        "    return observed, decision_log, daily_log\n",
        "\n",
        "\n",
        "def run_static(data: pd.DataFrame, shares: dict[str, float], daily_budget: float,\n",
        "               elasticity: float = 0.8) -> pd.DataFrame:\n",
        "    \"\"\"Baseline: the same fixed split every day (e.g. equal split).\"\"\"\n",
        "    allocation = {c: daily_budget * s for c, s in shares.items()}\n",
        "    days = [simulate_day(data[data[\"date\"] == d].set_index(\"channel\").assign(date=d), allocation, elasticity)\n",
        "            for d in sorted(data[\"date\"].unique())]\n",
        "    return pd.concat(days, ignore_index=True)\n",
        "\n",
        "\n",
        "def best_static_split(data: pd.DataFrame, daily_budget: float, elasticity: float = 0.8,\n",
        "                      min_share: float = 0.10, objective: str = \"conversions\", step: float = 0.05):\n",
        "    \"\"\"Hindsight reference: the best fixed split (respecting the floor) if you had\n",
        "    known the whole month in advance. Not achievable live - an upper-bound yardstick.\"\"\"\n",
        "    channels = sorted(data[\"channel\"].unique())\n",
        "    if len(channels) != 3:\n",
        "        return None  # the grid below is written for three channels\n",
        "    # Day x channel matrices, so each candidate split is scored in one vectorized step.\n",
        "    spend = data.pivot(index=\"date\", columns=\"channel\", values=\"spend\")[channels].to_numpy()\n",
        "    outcome = data.pivot(index=\"date\", columns=\"channel\", values=objective)[channels].to_numpy()\n",
        "\n",
        "    grid = [round(min_share + i * step, 4) for i in range(int(round((1 - min_share * 3) / step)) + 1)]\n",
        "    best_shares, best_value = None, -1.0\n",
        "    for a in grid:\n",
        "        for b in grid:\n",
        "            rest = round(1 - a - b, 4)\n",
        "            if rest < min_share - 1e-9:\n",
        "                continue\n",
        "            shares = np.array([a, b, rest])\n",
        "            value = (outcome * (shares * daily_budget / spend) ** elasticity).sum()  # same scaling as simulate_day\n",
        "            if value > best_value:\n",
        "                best_shares, best_value = dict(zip(channels, shares.tolist())), value\n",
        "    return best_shares\n",
        "\n",
        "\n",
        "def summarize(outcomes: pd.DataFrame) -> dict:\n",
        "    \"\"\"Totals and blended rates for a whole run.\"\"\"\n",
        "    t = outcomes[METRIC_COLUMNS].sum()\n",
        "    return {\n",
        "        \"spend\": t[\"spend\"],\n",
        "        \"impressions\": t[\"impressions\"],\n",
        "        \"clicks\": t[\"clicks\"],\n",
        "        \"conversions\": t[\"conversions\"],\n",
        "        \"ctr\": safe_div(t[\"clicks\"], t[\"impressions\"]),\n",
        "        \"cvr\": safe_div(t[\"conversions\"], t[\"clicks\"]),\n",
        "        \"cpa\": safe_div(t[\"spend\"], t[\"conversions\"]),\n",
        "        \"cpc\": safe_div(t[\"spend\"], t[\"clicks\"]),\n",
        "    }"
      ]
