        "%%writefile evaluate.py\n",
        "\"\"\"Robustness check: is the agent's win over the equal split real or a lucky dataset?\n",
        "\n",
        "Generates N mock datasets (different random seeds), runs the rule-based agent and\n",
        "the equal-split baseline on each, and repeats that for several diminishing-returns\n",
        "assumptions. Writes outputs/robustness.md.\n",
        "\n",
        "    python evaluate.py              # 20 seeds x elasticity 1.0 / 0.8 / 0.6\n",
        "    python evaluate.py --seeds 50\n",
        "\"\"\"\n",
        "\n",
        "import argparse\n",
        "import logging\n",
        "from pathlib import Path\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "from agent.guardrails import GuardrailConfig\n",
        "from agent.policy import HeuristicPolicy\n",
        "from agent.simulation import best_static_split, run_policy, run_static\n",
        "from data.generate_mock_data import generate\n",
        "\n",
        "ROOT = Path(__file__).resolve().parent\n",
        "DAILY_BUDGET = 3000.0\n",
        "\n",
        "\n",
        "def main() -> None:\n",
        "    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n",
        "    parser.add_argument(\"--seeds\", type=int, default=20)\n",
        "    parser.add_argument(\"--elasticities\", default=\"1.0,0.8,0.6\")\n",
        "    parser.add_argument(\"--out\", default=str(ROOT / \"outputs\" / \"robustness.md\"))\n",
        "    args = parser.parse_args()\n",
        "    logging.basicConfig(level=logging.WARNING)\n",
        "    guardrails = GuardrailConfig()\n",
        "\n",
        "    lines = [\n",
        "        \"# Robustness check\",\n",
        "        \"\",\n",
        "        f\"{args.seeds} mock datasets (seeds 1-{args.seeds}, 30 days x 3 channels), daily budget ${DAILY_BUDGET:,.0f}. \"\n",
        "        \"Lift = agent conversions / equal-split conversions - 1, same total spend. \"\n",
        "        \"'Share of hindsight gain' = how much of the best-fixed-split-in-hindsight improvement the agent captured live.\",\n",
        "        \"\",\n",
        "        \"| Elasticity | Mean lift | Min / max lift | Agent beats baseline | Mean CPA (agent vs baseline) | Share of hindsight gain |\",\n",
        "        \"|---:|---:|---:|---:|---:|---:|\",\n",
        "    ]\n",
        "    for elasticity in (float(e) for e in args.elasticities.split(\",\")):\n",
        "        lifts, wins, cpa_agent, cpa_base, captured = [], 0, [], [], []\n",
        "        for seed in range(1, args.seeds + 1):\n",
        "            data = generate(days=30, seed=seed)\n",
        "            data[\"date\"] = data[\"date\"].astype(\"datetime64[ns]\")\n",
        "            agent_out, _, _ = run_policy(data, HeuristicPolicy(guardrails), DAILY_BUDGET, guardrails, elasticity)\n",
        "            channels = sorted(data[\"channel\"].unique())\n",
        "            base_out = run_static(data, {c: 1 / len(channels) for c in channels}, DAILY_BUDGET, elasticity)\n",
        "            best_out = run_static(data, best_static_split(data, DAILY_BUDGET, elasticity), DAILY_BUDGET, elasticity)\n",
        "\n",
        "            agent_conv, base_conv = agent_out[\"conversions\"].sum(), base_out[\"conversions\"].sum()\n",
        "            lifts.append(agent_conv / base_conv - 1)\n",
        "            wins += agent_conv > base_conv\n",
        "            cpa_agent.append(agent_out[\"spend\"].sum() / agent_conv)\n",
        "            cpa_base.append(base_out[\"spend\"].sum() / base_conv)\n",
        "            captured.append((agent_conv - base_conv) / (best_out[\"conversions\"].sum() - base_conv))\n",
        "        lines.append(\n",
        "            f\"| {elasticity:.1f} | {np.mean(lifts):+.1%} | {min(lifts):+.1%} / {max(lifts):+.1%} | \"\n",
        "            f\"{wins}/{args.seeds} | ${np.mean(cpa_agent):.2f} vs ${np.mean(cpa_base):.2f} | {np.mean(captured):.0%} |\")\n",
        "        print(lines[-1])\n",
        "\n",
        "    lines += [\"\", \"Elasticity 1.0 = linear replay (optimistic); lower values = stronger diminishing returns \"\n",
        "              \"(each extra dollar in a channel buys less), which shrinks the payoff from reallocating.\", \"\"]\n",
        "    Path(args.out).write_text(\"\\n\".join(lines))\n",
        "    print(f\"\\nWrote {args.out}\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
