        "        ax.grid(axis=\"y\", color=GRID, linewidth=0.8)\n",
        "        ax.set_axisbelow(True)\n",
        "        ax.xaxis.set_major_locator(mdates.WeekdayLocator(byweekday=mdates.MO))\n",
        "        ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%b %d\"))\n",
        "\n",
        "    # Left: how the agent split the budget each day (stacked share).\n",
        "    share = agent_out.pivot(index=\"date\", columns=\"channel\", values=\"spend\")[channels] / daily_budget * 100\n",
        "    colors = [CHANNEL_COLORS.get(c, FALLBACK_COLORS[i % len(FALLBACK_COLORS)]) for i, c in enumerate(channels)]\n",
        "    ax1.stackplot(share.index, *[share[c] for c in channels], labels=channels, colors=colors,\n",
        "                  edgecolor=\"white\", linewidth=1.5)\n",
        "    ax1.axhline(100 / len(channels), color=INK, linestyle=\":\", linewidth=1)\n",
        "    ax1.annotate(\"equal split\", (share.index[0], 100 / len(channels)), textcoords=\"offset points\",\n",
        "                 xytext=(4, 4), fontsize=8, color=INK)\n",
        "    ax1.set_ylim(0, 100)\n",
        "    ax1.set_ylabel(\"Share of daily budget (%)\", color=INK, fontsize=9)\n",
        "    ax1.set_title(\"Agent's daily budget split\", loc=\"left\", color=INK, fontsize=11)\n",
        "    ax1.legend(loc=\"upper center\", bbox_to_anchor=(0.5, -0.08), fontsize=8, frameon=False, ncols=len(channels))\n",
        "\n",
        "    # Right: cumulative outcome, agent vs baseline.\n",
        "    cum_agent = agent_out.groupby(\"date\")[key].sum().cumsum()\n",
        "    cum_base = baseline_out.groupby(\"date\")[key].sum().cumsum()\n",
        "    ax2.plot(cum_agent.index, cum_agent.values, color=INK, linewidth=2, label=\"Agent\")\n",
        "    ax2.plot(cum_base.index, cum_base.values, color=MUTED, linewidth=2, linestyle=\"--\", label=\"Equal split\")\n",
        "    ax2.annotate(f\"{cum_agent.iloc[-1]:,.0f}\", (cum_agent.index[-1], cum_agent.iloc[-1]),\n",
