        "                return self._fallback(\"response blocked\" if blocked else \"model ended without submitting a plan\", *args)\n",
        "\n",
        "            contents.append(response.candidates[0].content)  # keep the model's turn (incl. thought signatures)\n",
        "            replies = []\n",
        "            for call in calls:\n",
        "                if call.name == \"submit_budget_plan\" and metrics_read:\n",
