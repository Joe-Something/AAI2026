        "%%writefile run_agent.py\n",
        "\"\"\"Ad budget optimization agent - main entry point.\n",
        "\n",
        "Reads the performance CSV, lets the agent allocate the daily budget day by day,\n",
        "compares it with an equal-split baseline, and writes logs, a results snapshot\n",
        "and a chart to outputs/.\n",
        "\n",
        "Examples:\n",
        "    python run_agent.py                                  # rule-based agent, default CSV\n",
        "    python run_agent.py --policy llm                     # Gemini proposes, guardrails enforce\n",
        "    python run_agent.py --objective clicks --elasticity 1.0\n",
        "\"\"\"\n",
        "\n",
        "import argparse\n",
        "import json\n",
        "import logging\n",
        "import time\n",
        "import uuid\n",
        "from datetime import datetime, timezone\n",
        "from pathlib import Path\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "from agent.data import load_performance_csv\n",
        "from agent.guardrails import GuardrailConfig\n",
        "from agent.policy import HeuristicPolicy\n",
        "from agent.report import plot_results, write_summary\n",
        "from agent.simulation import best_static_split, run_policy, run_static, summarize\n",
        "\n",
        "ROOT = Path(__file__).resolve().parent\n",
        "\n",
        "\n",
        "def parse_args() -> argparse.Namespace:\n",
        "    p = argparse.ArgumentParser(description=\"Allocate a daily ad budget across channels.\")\n",
        "    p.add_argument(\"--data\", default=str(ROOT / \"data\" / \"ad_performance.csv\"), help=\"input CSV\")\n",
        "    p.add_argument(\"--policy\", choices=[\"heuristic\", \"llm\"], default=\"heuristic\",\n",
        "                   help=\"heuristic = rule-based (no API key needed); llm = Gemini via function calling\")\n",
        "    p.add_argument(\"--objective\", choices=[\"conversions\", \"clicks\"], default=\"conversions\")\n",
        "    p.add_argument(\"--daily-budget\", type=float, default=None,\n",
        "                   help=\"total $ per day (default: average daily spend in the CSV)\")\n",
        "    p.add_argument(\"--elasticity\", type=float, default=0.8,\n",
        "                   help=\"diminishing-returns exponent for the replay (1.0 = linear)\")\n",
        "    p.add_argument(\"--min-share\", type=float, default=0.10, help=\"per-channel budget floor (share)\")\n",
        "    p.add_argument(\"--max-share\", type=float, default=0.70, help=\"per-channel budget cap (share)\")\n",
        "    p.add_argument(\"--max-change\", type=float, default=0.20, help=\"max daily change per channel\")\n",
        "    p.add_argument(\"--out\", default=str(ROOT / \"outputs\"), help=\"output folder\")\n",
        "    p.add_argument(\"--quiet\", action=\"store_true\", help=\"don't print the per-day decision log\")\n",
        "    return p.parse_args()\n",
        "\n",
        "\n",
        "def main() -> None:\n",
        "    args = parse_args()\n",
        "    logging.basicConfig(level=logging.INFO, format=\"%(levelname)s %(name)s: %(message)s\")\n",
        "    out_dir = Path(args.out)\n",
        "    out_dir.mkdir(parents=True, exist_ok=True)\n",
        "    run_id = uuid.uuid4().hex[:8]\n",
        "    started = time.perf_counter()\n",
        "\n",
        "    # 1) Read the data.\n",
        "    data = load_performance_csv(args.data)\n",
        "    channels = sorted(data[\"channel\"].unique())\n",
        "    n_days = data[\"date\"].nunique()\n",
        "    daily_budget = args.daily_budget or round(data.groupby(\"date\")[\"spend\"].sum().mean(), -1)\n",
        "    guardrails = GuardrailConfig(args.min_share, args.max_share, args.max_change)\n",
        "    print(f\"Run {run_id}: {n_days} days x {len(channels)} channels ({', '.join(channels)}), \"\n",
        "          f\"daily budget ${daily_budget:,.0f}, objective={args.objective}, policy={args.policy}\")\n",
        "\n",
        "    # 2) Pick the policy. The LLM import is lazy so the default path needs no SDK/API key.\n",
        "    if args.policy == \"llm\":\n",
        "        from agent.llm_policy import GeminiPolicy\n",
        "        policy = GeminiPolicy(guardrails, args.objective)\n",
        "    else:\n",
        "        policy = HeuristicPolicy(guardrails, args.objective)\n",
        "\n",
        "    # 3) Run the agent and the baselines on the same days and the same budget.\n",
        "    agent_out, decision_log, daily_log = run_policy(\n",
        "        data, policy, daily_budget, guardrails, args.elasticity, args.objective)\n",
        "    equal_shares = {c: 1 / len(channels) for c in channels}\n",
        "    baseline_out = run_static(data, equal_shares, daily_budget, args.elasticity)\n",
        "    best_shares = best_static_split(data, daily_budget, args.elasticity, args.min_share, args.objective)\n",
        "    hindsight_out = run_static(data, best_shares, daily_budget, args.elasticity) if best_shares else None\n",
        "\n",
        "    # 4) Print the decision log (the \"rationale\" for every budget move).\n",
        "    if not args.quiet:\n",
        "        print(\"\\nDecision log\")\n",
        "        for day in daily_log:\n",
        "            print(f\"\\n{day['date']} (day {day['day']}) - {day['summary']}  [{day['policy']}]\")\n",
        "            for row in (r for r in decision_log if r[\"date\"] == day[\"date\"]):\n",
        "                print(f\"  {row['reason']}\")\n",
        "\n",
        "    # 5) Save logs and the results snapshot.\n",
        "    pd.DataFrame(decision_log).to_csv(out_dir / \"decision_log.csv\", index=False)\n",
