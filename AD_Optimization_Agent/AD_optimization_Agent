      "source": [
        "%%writefile agent/data.py\n",
        "\"\"\"Reading and validating the performance CSV (the agent's only data input).\"\"\"\n",
        "\n",
        "import logging\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "log = logging.getLogger(__name__)\n",
        "\n",
        "REQUIRED_COLUMNS = [\"date\", \"channel\", \"spend\", \"impressions\", \"clicks\", \"conversions\"]\n",
        "METRIC_COLUMNS = [\"spend\", \"impressions\", \"clicks\", \"conversions\"]\n",
        "\n",
        "# Privacy guardrail: the agent works on aggregated channel-level numbers only.\n",
        "# If a file looks like it carries user-level data, refuse to process it.\n",
        "PII_HINTS = (\"email\", \"user\", \"customer\", \"phone\", \"ip\", \"address\", \"name\", \"cookie\", \"device_id\")\n",
        "\n",
        "\n",
        "def load_performance_csv(path: str) -> pd.DataFrame:\n",
        "    \"\"\"Load the CSV, validate it, and return clean rows sorted by date and channel.\"\"\"\n",
        "    df = pd.read_csv(path)\n",
        "    df.columns = [c.strip().lower() for c in df.columns]\n",
        "\n",
        "    missing = [c for c in REQUIRED_COLUMNS if c not in df.columns]\n",
        "    if missing:\n",
        "        raise ValueError(f\"CSV is missing required columns: {missing}\")\n",
        "\n",
        "    suspicious = [c for c in df.columns if c not in REQUIRED_COLUMNS and any(h in c for h in PII_HINTS)]\n",
        "    if suspicious:\n",
        "        raise ValueError(f\"Refusing to run: columns {suspicious} look like personal data. \"\n",
        "                         \"Provide channel-level aggregates only.\")\n",
        "\n",
        "    df = df[REQUIRED_COLUMNS].copy()\n",
        "    df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
        "    df[\"channel\"] = df[\"channel\"].astype(str).str.strip()\n",
        "    df[METRIC_COLUMNS] = df[METRIC_COLUMNS].apply(pd.to_numeric, errors=\"coerce\")\n",
        "\n",
        "    # Data-quality guardrail: drop rows that cannot be real (negative or missing\n",
        "    # numbers, more clicks than impressions, more conversions than clicks).\n",
        "    bad = (\n",
        "        df[METRIC_COLUMNS].isna().any(axis=1)\n",
        "        | (df[METRIC_COLUMNS] < 0).any(axis=1)\n",
        "        | (df[\"clicks\"] > df[\"impressions\"])\n",
        "        | (df[\"conversions\"] > df[\"clicks\"])\n",
        "    )\n",
        "    if bad.any():\n",
        "        log.warning(\"Dropping %d invalid row(s): %s\", bad.sum(), df[bad].to_dict(\"records\"))\n",
        "    df = df[~bad]\n",
        "\n",
        "    # One row per (date, channel); sum duplicates if the export split them.\n",
        "    df = df.groupby([\"date\", \"channel\"], as_index=False)[METRIC_COLUMNS].sum()\n",
        "    return df.sort_values([\"date\", \"channel\"]).reset_index(drop=True)"
      ]
    },
