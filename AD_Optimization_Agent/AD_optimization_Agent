        "%%writefile agent/report.py\n",
        "\"\"\"Results snapshot (markdown) and chart.\"\"\"\n",
        "\n",
        "from pathlib import Path\n",
        "\n",
        "import matplotlib\n",
        "\n",
        "matplotlib.use(\"Agg\")  # render to file; no display needed\n",
        "import matplotlib.dates as mdates  # noqa: E402\n",
        "import matplotlib.pyplot as plt  # noqa: E402\n",
        "import pandas as pd  # noqa: E402\n",
        "\n",
        "# Fixed colour per channel (colour follows the channel, never its rank).\n",
        "CHANNEL_COLORS = {\"Search\": \"#2a78d6\", \"Social\": \"#eb6834\", \"Display\": \"#1baf7a\"}\n",
        "FALLBACK_COLORS = [\"#2a78d6\", \"#eb6834\", \"#1baf7a\", \"#eda100\", \"#e87ba4\"]\n",
        "INK, MUTED, GRID = \"#0b0b0b\", \"#8a8984\", \"#e4e3df\"\n",
        "\n",
        "\n",
        "def write_summary(path: Path, results: dict, args, daily_budget: float, n_days: int,\n",
        "                  agent_out: pd.DataFrame, baseline_out: pd.DataFrame, decision_log: list[dict]) -> str:\n",
        "    agent, base = results[\"Agent\"], results[\"Equal split (baseline)\"]\n",
        "    objective = args.objective\n",
        "    key = \"conversions\" if objective == \"conversions\" else \"clicks\"\n",
        "    lines = [\n",
        "        \"# Results snapshot\",\n",
        "        \"\",\n",
        "        f\"{n_days} days, daily budget ${daily_budget:,.0f} (same total spend for every strategy), \"\n",
        "        f\"objective = **{objective}**, policy = {args.policy}, replay elasticity = {args.elasticity}.\",\n",
        "        \"\",\n",
        "        f\"| Strategy | Conversions | Clicks | Spend | CPA | CVR | CTR | {key.title()} vs baseline |\",\n",
        "        \"|---|---:|---:|---:|---:|---:|---:|---:|\",\n",
        "    ]\n",
        "    for name, r in results.items():\n",
        "        lift = r[key] / base[key] - 1\n",
        "        lines.append(f\"| {name} | {r['conversions']:,.0f} | {r['clicks']:,.0f} | ${r['spend']:,.0f} | \"\n",
        "                     f\"${r['cpa']:.2f} | {r['cvr']:.2%} | {r['ctr']:.2%} | {lift:+.1%} |\")\n",
        "\n",
        "    gain = agent[key] - base[key]\n",
        "    lines += [\n",
        "        \"\",\n",
        "        f\"**Agent vs equal split:** {gain:+,.0f} {key} ({agent[key] / base[key] - 1:+.1%}) for the same spend; \"\n",
        "        f\"CPA ${base['cpa']:.2f} -> ${agent['cpa']:.2f}.\",\n",
        "        \"\",\n",
        "        \"Average share of budget per channel (agent):\",\n",
        "        \"\",\n",
        "    ]\n",
        "    shares = agent_out.groupby(\"channel\")[\"spend\"].sum() / agent_out[\"spend\"].sum()\n",
        "    last_day = agent_out[agent_out[\"date\"] == agent_out[\"date\"].max()].set_index(\"channel\")[\"spend\"]\n",
        "    for c in shares.index:\n",
        "        lines.append(f\"- {c}: {shares[c]:.0%} on average, {last_day[c] / daily_budget:.0%} on the last day\")\n",
        "\n",
        "    # A few example rationale strings from the log.\n",
        "    examples = []\n",
        "    for want in (\"up\", \"down\", \"guardrail\", \"hold\"):\n",
        "        match = next((r[\"reason\"] for r in decision_log if f\" {want}\" in r[\"reason\"] and r[\"reason\"] not in examples), None)\n",
        "        if match:\n",
        "            examples.append(match)\n",
        "    lines += [\"\", \"Example decision log entries:\", \"\"] + [f\"- `{e}`\" for e in examples[:4]] + [\"\"]\n",
        "\n",
        "    text = \"\\n\".join(lines)\n",
        "    Path(path).write_text(text)\n",
        "    return text\n",
        "\n",
        "\n",
        "def plot_results(path: Path, agent_out: pd.DataFrame, baseline_out: pd.DataFrame,\n",
        "                 channels: list[str], daily_budget: float, objective: str) -> None:\n",
        "    key = \"conversions\" if objective == \"conversions\" else \"clicks\"\n",
